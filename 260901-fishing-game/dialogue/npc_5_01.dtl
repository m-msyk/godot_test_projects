if QuestManager.is_quest_not_started("talk_to_vicky") and QuestManager.is_quest_not_started("talk_to_researcher_2"):
	researcher_2: Talk to Aylisha, she's on B2.
	[signal arg="quest_started:talk_to_aylisha"]
elif QuestManager.is_quest_in_progress("talk_to_researcher_2") and QuestManager.is_quest_not_started("talk_to_vicky"):
	researcher_2: Oh, Aylisha wanted you to see me?
	researcher_2: Thanks for letting me know.
	[signal arg="objective_completed:talk_to_researcher_2:talk_to_blockid_objective"]
	researcher_2: Actually, do you mind going back and asking her to come see me?
	[signal arg="quest_started:talk_to_aylisha"]
elif QuestManager.is_quest_in_progress("talk_to_vicky"):
	researcher_2: You're talking to me after starting the quest.
elif QuestManager.is_quest_completed("talk_to_vicky"):
	researcher_2: Thanks for talking to Aylisha.
else:
	researcher_2: No more talking, phew.